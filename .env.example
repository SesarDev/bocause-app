# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.
#
# Este archivo es una PLANTILLA y se versiona: déjalo siempre con los valores vacíos.
#
# Dónde encontrarlos: Supabase → tu proyecto → Project Settings → API
#   VITE_SUPABASE_URL      = "Project URL". Tiene la forma https://<ref>.supabase.co
#                            (NO la URL del dashboard supabase.com/dashboard/project/<ref>)
#   VITE_SUPABASE_ANON_KEY = clave "anon" / "publishable" (la pública, nunca la service_role)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
