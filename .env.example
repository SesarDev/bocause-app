# Este archivo es una PLANTILLA y se versiona: déjalo siempre con los valores vacíos.
# Copia a .env.local (que está en .gitignore) y rellena ahí.
#
# Supabase → tu proyecto → Project Settings → API
#   VITE_SUPABASE_URL      = "Project URL". Tiene la forma https://<ref>.supabase.co
#                            (NO la URL del dashboard supabase.com/dashboard/project/<ref>)
#   VITE_SUPABASE_ANON_KEY = clave "anon" / "publishable" (la pública, nunca la service_role)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────── Solo para `npm run seed`, nunca para la app ───────────
#
# La clave service_role salta TODAS las políticas RLS. No lleva prefijo VITE_ a propósito,
# para que Vite no la meta en el JavaScript que se descarga el móvil. Solo hace falta la
# primera vez, para crear el hogar.
SUPABASE_SERVICE_ROLE_KEY=

# Reserva cada perfil a un correo, para que nadie que se registre pueda ocuparlo.
# Si se dejan vacíos, cualquier usuario autenticado podría elegir cualquier perfil libre.
SEED_EMAIL_CRISTINA=
SEED_EMAIL_ANDRES=

# ─────────── Solo para `npm run migrate` ───────────
#
# Conexión directa a Postgres, con la contraseña de la base de datos dentro. Settings →
# Database → Connection string → URI. Usa la de "Session pooler" si tu red no tiene IPv6,
# que es lo normal en casa. Lleva la contraseña en claro: nunca fuera de .env.local.
SUPABASE_DB_URL=
