# Hogar de demostración, con datos ficticios. Lo usa `npm run seed:demo`.
#
# Sirve para enseñar la app sin exponer la dieta de nadie, y para probar la zona de
# administración contra un hogar que no es el de casa.
#
# Este archivo SÍ se versiona: no tiene secretos, solo nombres de mentira. Las claves de
# conexión siguen saliendo de .env.local, que se carga antes.

SEED_HOUSEHOLD_NAME=Hogar demo

# Id propio para el plan. `plans.id` es clave primaria GLOBAL, no por hogar: sin esto, el
# seed haría upsert sobre la fila del hogar de verdad y le movería el plan.
SEED_PLAN_ID=demo-2026-09

# Nombres ficticios. Los slugs internos siguen siendo cristina/andres (son únicos por hogar
# y el plan los usa en cada celda), pero lo que se ve en pantalla no son nombres reales.
SEED_NAME_CRISTINA=Cliente A
SEED_NAME_ANDRES=Cliente B

# Sin correo reservado: así cualquiera puede ocupar estos perfiles para probar.
SEED_EMAIL_CRISTINA=
SEED_EMAIL_ANDRES=
